# Copy to .env.local and fill in from Supabase → Project Settings → API
# NEVER put real keys in this file — it is committed to git.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. This is the secret key (service_role) — never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your deployed URL (used for Supabase Auth redirects). Local dev:
# http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
