# ---------------------------------------------------------------------------
# Copy to .env.local for local dev, and set these in Vercel → Settings →
# Environment Variables for production.
# ---------------------------------------------------------------------------

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC, never commit this value.
# Supabase → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The canonical public URL of this deployment, WITHOUT trailing slash.
# For your Vercel deployment:
NEXT_PUBLIC_SITE_URL=https://minetallest-minetree.vercel.app
# (If you later attach a custom domain, change it to https://yourdomain.com —
#  this value controls QR codes, share URLs, SEO metadata and email links.)
